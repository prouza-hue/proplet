{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hrajproplet.cz/schemas/tajenka-content-v2.json",
  "title": "Proplet Tajenka v2 authoring bank",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "bankId",
    "runtimeEnabled",
    "status",
    "candidates"
  ],
  "properties": {
    "$schema": {
      "const": "./tajenka-content.schema.json"
    },
    "schemaVersion": {
      "const": 2
    },
    "bankId": {
      "type": "string",
      "minLength": 1
    },
    "runtimeEnabled": {
      "const": false
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "candidateNo",
          "category",
          "displayText",
          "immutable",
          "anchors",
          "companions",
          "expectedValidation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^tajenka-v2-c[0-9]{2}$"
          },
          "candidateNo": {
            "type": "integer",
            "minimum": 1
          },
          "category": {
            "enum": [
              "observation",
              "fact",
              "czech",
              "proverb",
              "quote"
            ]
          },
          "displayText": {
            "type": "string",
            "minLength": 1
          },
          "immutable": {
            "type": "boolean"
          },
          "anchors": {
            "type": "array",
            "minItems": 2,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "surface",
                "suitability"
              ],
              "properties": {
                "surface": {
                  "type": "string",
                  "minLength": 1
                },
                "suitability": {
                  "enum": [
                    "strong",
                    "acceptable",
                    "weak"
                  ]
                }
              }
            }
          },
          "companions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "revealWith",
                "significant"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "revealWith": {
                  "type": "string",
                  "minLength": 1
                },
                "significant": {
                  "type": "boolean"
                }
              }
            }
          },
          "shortAnchorJustification": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "label",
              "url"
            ],
            "properties": {
              "status": {
                "enum": [
                  "verified",
                  "needs-verification"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "pattern": "^https://"
              }
            }
          },
          "expectedValidation": {
            "enum": [
              "pass",
              "fail"
            ]
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
