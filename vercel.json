{
  "framework": null,
  "builds": [
    {
      "use": "@vercel/static",
      "src": "public/**"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "Content-Security-Policy": "default-src 'self'; connect-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; worker-src 'none'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'",
        "X-Robots-Tag": "noindex, nofollow",
        "Cache-Control": "no-store",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "no-referrer"
      },
      "continue": true
    },
    {
      "src": "/api(?:/.*)?",
      "status": 404
    },
    {
      "src": "/sw.js",
      "status": 404
    },
    {
      "src": "/",
      "dest": "/public/patron-preview.html"
    },
    {
      "src": "/index.html",
      "dest": "/public/patron-preview.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
