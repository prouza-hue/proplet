{
  "framework": null,
  "builds": [
    {
      "use": "@vercel/static",
      "src": "preview-public/**"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "Content-Security-Policy": "default-src 'self'; connect-src 'self'; img-src 'self' data: blob:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; object-src 'none'; frame-src 'none'; worker-src 'none'; form-action 'none'; base-uri 'none'",
        "X-Robots-Tag": "noindex, nofollow",
        "Cache-Control": "no-store",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "no-referrer"
      },
      "continue": true
    },
    {
      "src": "/api(?:/.*)?",
      "status": 404
    },
    {
      "src": "/sw.js",
      "status": 404
    },
    {
      "src": "/_vercel/(?:insights|speed-insights)(?:/.*)?",
      "status": 404
    },
    {
      "src": "/",
      "dest": "/preview-public/index.html"
    },
    {
      "src": "/index.html",
      "dest": "/preview-public/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/preview-public/$1"
    }
  ]
}
